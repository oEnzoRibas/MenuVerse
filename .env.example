# O modo local funciona sem configuração. Opcionalmente, mude o arquivo SQLite.
# MENUVERSE_DEMO_DB=.data/demo.sqlite

# Demonstração hospedada. Use um projeto Supabase exclusivo para a demo.
SUPABASE_DEMO_URL=
SUPABASE_DEMO_SECRET_KEY=

# Operação autenticada. Use o URL e a chave publicável do projeto de operação.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Checkout público da operação. Somente no servidor.
SUPABASE_ORDER_SECRET_KEY=
# Gere um segredo aleatório com pelo menos 32 caracteres.
MENUVERSE_TRACKING_SECRET=
